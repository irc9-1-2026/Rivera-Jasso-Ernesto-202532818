# Clave secreta de Flask (usa una cadena aleatoria y larga)
FLASK_SECRET_KEY=

# API key de Steam
# Se obtiene en: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Dominio/realm autorizado para el login OpenID (debe coincidir con
# el dominio desde el que corre la app, sin ruta)
STEAM_REALM=http://localhost:5000/

# URL exacta a la que Steam redirige tras el login
STEAM_RETURN_URL=http://localhost:5000/callback